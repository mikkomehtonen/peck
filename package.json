{
  "name": "kiss-spec",
  "version": "0.1.0",
  "description": "Spec-driven development CLI",
  "type": "module",
  "bin": {
    "kiss-spec": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "bun dist/index.js",
    "test": "bun run build && vitest run",
    "test:watch": "vitest",
    "install:local": "bun run build && bun add -g $(pwd)"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
